{
  "name": "atlp-recommendations",
  "version": "2.0.0",
  "description": "After The Last Page deterministic vector recommendation microservice",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:index": "node scripts/buildVectorIndex.js",
    "ingest:openlibrary": "node scripts/ingestOpenLibrarySubjects.js",
    "check": "node --check app.js && node --check server.js && find controllers models routes services scripts -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "npm run check"
  },
  "keywords": [
    "recommendations",
    "books",
    "vectors",
    "embeddings"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.6.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
