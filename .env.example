MONGODB_URI=mongodb+srv://user:password@cluster.example/atlp
PORT=3000
ADMIN_INDEX_TOKEN=replace-with-long-random-secret
ALLOW_ADMIN_INDEX_BUILD=false
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=16
DEFAULT_RECOMMENDATION_LIMIT=24
MAX_RECOMMENDATION_LIMIT=50
VECTOR_CANDIDATE_LIMIT=7500
CURATED_COLLECTION_SIZE=50
OPENLIBRARY_SUBJECTS=fantasy,science_fiction,mystery,romance,historical_fiction,adventure,horror,poetry,biography,philosophy
OPENLIBRARY_LIMIT_PER_SUBJECT=100
